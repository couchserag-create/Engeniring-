from __future__ import annotations

import csv
import json
import os
from pathlib import Path
from typing import Any, Dict, List

from core.collectors.base import BaseCollector, CollectorResult


class ClientCollector(BaseCollector):
    """Load client data from local JSON or CSV source."""

    source_name = "client"

    def __init__(self, domain: str, source_dir: str | None = None):
        super().__init__(domain)
        self.source_dir = Path(source_dir or os.getenv("CLIENT_DATA_DIR", "data/clients"))

    def collect(self) -> CollectorResult:
        records: List[Dict[str, Any]] = []
        metadata: Dict[str, Any] = {"source_dir": str(self.source_dir)}

        if not self.source_dir.exists():
            return CollectorResult(
                source=self.source_name,
                domain=self.domain,
                collected_at=self._timestamp(),
                records=[],
                metadata={**metadata, "status": "missing_source"},
            )

        for file in sorted(self.source_dir.iterdir()):
            if file.suffix.lower() == ".json":
                try:
                    data = json.loads(file.read_text(encoding="utf-8"))
                    if isinstance(data, list):
                        records.extend(data)
                    else:
                        records.append(data)
                except json.JSONDecodeError:
                    continue
            elif file.suffix.lower() == ".csv":
                with file.open("r", encoding="utf-8", newline="") as fh:
                    rows = list(csv.DictReader(fh))
                    records.extend(rows)

        metadata["files_processed"] = len([p for p in self.source_dir.iterdir() if p.is_file()])
        return CollectorResult(
            source=self.source_name,
            domain=self.domain,
            collected_at=self._timestamp(),
            records=records,
            metadata=metadata,
        )

    def _timestamp(self) -> str:
        from datetime import datetime, timezone
        return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
